{
  "name": "@fullview/react-native-fullview-sdk",
  "version": "0.13.0-rc.1",
  "description": "Fullview SDK for React Native: live support meetings with screen sharing and data redaction, with the native iOS and Android libraries bundled.",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @fullview/react-native-fullview-sdk-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib plugin/build",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "prepare": "bob build && yarn build:plugin",
    "codegen:check": "node node_modules/react-native/scripts/generate-codegen-artifacts.js -p example -o example/build/codegen-check -t all",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "fullview",
    "session-replay",
    "cobrowsing",
    "screen-sharing",
    "support"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullviewdev/react-native-fullview-sdk.git"
  },
  "author": "Fullview <support@fullview.io> (https://github.com/fullviewdev/react-native-fullview-sdk)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fullviewdev/react-native-fullview-sdk/issues"
  },
  "homepage": "https://github.com/fullviewdev/react-native-fullview-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@evilmartians/lefthook": "^1.13.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "commitlint": "^19.8.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo": "^57.0.26",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "release-it": "^19.0.5",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@types/react": "^19.2.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.82.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/plugin/build/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": "main"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "version": "0.63.1"
  },
  "types": "./lib/typescript/module/src/index.d.ts",
  "engines": {
    "node": ">=22.11.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "FullviewSdkSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.fullviewsdk"
    },
    "ios": {
      "modulesProvider": {
        "FullviewSdk": "FullviewSdk"
      },
      "components": {
        "DataRedactionView": {
          "className": "DataRedactionView"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
